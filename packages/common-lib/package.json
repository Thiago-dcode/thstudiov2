{
  "name": "@repo/common-lib",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "tsc --watch",
    "dev:backend": "tsc --watch",
    "build": "tsc --incremental false",
    "test": "jest  --passWithNoTests --config ./jest.config.ts",
    "test:watch": "jest  --passWithNoTests --config ./jest.config.ts  --watch",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./jest.config.ts"
  },
  "exports": {
    ".": "./dist/index.js",
    "./constants/*": "./dist/constants/*.js",
    "./utils/*": "./dist/utils/*.js",
    "./types/*": "./dist/types/*.js",
    "./schemas/*": "./dist/schemas/*.js",
    "./config": "./dist/config/index.js",
    "./config/utils": "./dist/config/utils.js"
  },
  "dependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/multer": "^2.2.0",
    "bcrypt": "^6.0.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "install": "^0.13.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@repo/jest-config": "workspace:*",
    "@types/multer": "^2.2.0",
    "@repo/typescript-config": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.1.2",
    "jest": "30.4.2",
    "ts-jest": "29.4.12",
    "typescript": "^6.0.3"
  }
}
