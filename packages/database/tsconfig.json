{
  "extends": "@repo/typescript-config/nestjs.json",
  "compilerOptions": {
    "allowJs": true,
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0"
  },
  "module": "esnext",
  "moduleResolution": "bundler",
  "paths": {
    "@": [
      "./src"
    ]
  },
  "include": [
    "src",
    "jest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*spec.ts",
    "**/*.test.ts",
    "**/__tests__/**"
  ]
}
