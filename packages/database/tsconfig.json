{
  "extends": "@repo/typescript-config/nestjs.json",
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "module": "esnext",
  "moduleResolution": "bundler",
  "paths": {
    "@": [
      "./src"
    ]
  },
  "include": [
    "src",
    "jest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}