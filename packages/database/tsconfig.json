{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": "src",
    "esModuleInterop": true,
    "incremental": false,
    "outDir": "dist"
  },
  "paths": {
    "@": ["src/*"],
    "@/*": ["src/*"],
    "@lib/*": ["src/lib/*"],
    "lib/*": ["src/lib/*"]
  },
  "include": [
    "./src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
