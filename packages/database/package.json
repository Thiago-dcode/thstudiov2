{
  "name": "@repo/database",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc --incremental false",
    "dev": "tsc --watch",
    "test": "jest  --passWithNoTests --config ./jest.config.ts ",
    "test:watch": "jest  --passWithNoTests --config ./jest.config.ts  --watch",
    "dbcli": "node dist/src/bin/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./queryBuilder": "./dist/src/lib/builder/queryBuilder/index.js",
    "./schemaBuilder": "./dist/src/lib/builder/schemaBuilder/index.js",
    "./alterBuilder": "./dist/src/lib/builder/alterBuilder/index.js",
    "./columnBuilder": "./dist/src/lib/builder/columnBuilder/index.js",
    "./facades": "./dist/src/lib/facades/index.js",
    "./exceptions": "./dist/src/lib/exceptions/index.js",
    "./repositories": "./dist/src/lib/repositories/base.repository.js",
    "./repositories/media": "./dist/src/lib/repositories/media.repository.js",
    "./repositories/user-extra-data": "./dist/src/lib/repositories/user-extra-data.repository.js",
    "./repositories/plans": "./dist/src/lib/repositories/plans.repository.js"
  },
  "bin": {
    "dbcli": "./dist/src/bin/cli.js"
  },
  "dependencies": {
    "@repo/backend-lib": "workspace:*",
    "@repo/common-lib": "workspace:*",
    "bcrypt": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.8",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.20",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "tsx": "^4.23.15"
  }
}
