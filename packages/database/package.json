{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "jest  --passWithNoTests --config ./jest.config.ts ",
    "test:watch": "jest  --passWithNoTests --config ./jest.config.ts  --watch",
    "create:migration": "tsx --tsconfig tsconfig.json src/lib/migration/create-migration.ts",
    "migrate": "tsx --tsconfig tsconfig.json src/lib/migration/migrate.ts",
    "rollback": "tsx --tsconfig tsconfig.json src/lib/migration/rollback.ts",
    "wipe": "tsx --tsconfig tsconfig.json src/lib/migration/wipe-db.ts",
    "dbcli": "tsx --tsconfig tsconfig.json src/bin/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "dbcli": "./src/bin/cli.ts"
  },
  "dependencies": {
    "@repo/backend-lib": "workspace:*",
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/jest": "^30.0.0",
    "commander": "^14.0.0",
    "dotenv": "^16.4.5",
    "jest": "^29.7.0",
    "mysql2": "^3.14.3",
    "pg": "^8.16.3",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.7.0"
  }
}
