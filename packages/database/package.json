  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "jest": "30.4.2",
    "ts-jest": "29.4.12",
    "tsx": "^4.23.1"
  }
