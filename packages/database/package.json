  },
  "dependencies": {
    "@repo/backend-lib": "workspace:*",
    "@repo/common-lib": "workspace:*",
    "bcrypt": "^6.0.0",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "mysql2": "^3.23.2",
    "pg": "^8.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
