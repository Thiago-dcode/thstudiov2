{
  "name": "@repo/backend-lib",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "dev:backend": "tsc -p tsconfig.build.json --watch",
    "build": "tsc -p tsconfig.build.json --incremental false",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests --config ./jest.config.ts",
    "test:watch": "jest  --passWithNoTests --config ./jest.config.ts  --watch",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./jest.config.ts"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./utils": "./dist/src/utils/index.js",
    "./utils/*": "./dist/src/utils/*.js",
    "./config/*": "./dist/src/config/*.js",
    "./services/*": "./dist/src/services/*/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1173.0",
    "@aws-sdk/s3-request-presigner": "3.1173.0",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "@repo/common-lib": "workspace:*",
    "@types/ejs": "^3.1.5",
    "@types/multer": "^2.3.0",
    "@types/pug": "^2.0.10",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "ejs": "^7.0.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^190.0.0",
    "image-size": "^2.1.0",
    "install": "^0.13.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.6.0",
    "openai": "^7.62.0",
    "picocolors": "^1.1.1",
    "pug": "^3.0.4",
    "redis": "^6.3.1",
    "resend": "^6.39.0",
    "sharp": "0.35.5",
    "stripe": "^22.6.2",
    "uuid": "^14.0.3"
  },
  "peerDependencies": {
    "bullmq": "^6.0.0"
  },
