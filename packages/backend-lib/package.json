{
  "name": "@repo/backend-lib",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "tsc --watch",
    "dev:backend": "tsc --watch",
    "build": "tsc",
    "test": "jest  --passWithNoTests --config ./jest.config.ts",
    "test:watch": "jest  --passWithNoTests --config ./jest.config.ts  --watch",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./jest.config.ts"
  },
  "exports": {
    ".": "./dist/index.js",
    "./config": "./dist/config/index.js",
    "./utils": "./dist/utils/index.js",
    "./utils/console": "./dist/utils/console.js"
  },
  "peerDependencies": {
    "@nestjs/common": ">=11.0.0",
    "@nestjs/config": ">=4.0.2",
    "@nestjs/core": ">=11.0.0",
    "@nestjs/platform-express": ">=11.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.1",
    "typescript": "^5.8.2"
  }
}
