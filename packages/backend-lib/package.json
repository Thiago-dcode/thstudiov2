{
  "name": "@repo/backend-lib",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "tsc --watch",
    "dev:backend": "tsc --watch",
    "build": "tsc",
    "test": "jest  --passWithNoTests --config ./jest.config.ts",
    "test:watch": "jest  --passWithNoTests --config ./jest.config.ts  --watch",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./jest.config.ts"
  },
  "exports": {
    ".": "./dist/index.js",
    "./config": "./dist/src/config/index.js",
    "./utils": "./dist/src/utils/index.js",
    "./utils/console": "./dist/src/utils/console.js"
  },
  "peerDependencies": {
    "@nestjs/common": ">=11.0.0",
    "@nestjs/config": ">=4.0.2",
    "@nestjs/core": ">=11.0.0",
    "@nestjs/platform-express": ">=11.0.0"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/jest": "29.5.14",
    "@types/node": "^22.18.6",
    "jest": "29.1.1",
    "ts-jest": "29.1.1",
    "typescript": "^5.9.2"
  }
}
