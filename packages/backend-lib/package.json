  },
  "dependencies": {
  
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/jest-config": "workspace:*",
    "@types/jest": "^30.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.1",
    "typescript": "^5.8.2"
  }
