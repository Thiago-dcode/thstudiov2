{
  "name": "@repo/ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --max-warnings 0",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit"
  },
  "exports": {
    "./lib/*": "./src/lib/*.ts",
