{
  "name": "@repo/jest-config",
  "version": "0.0.0",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "test": "jest  --passWithNoTests --config ./jest.config.ts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./base": {
      "import": "./dist/base/index.js",
      "require": "./dist/base/index.js",
      "types": "./dist/base/index.d.ts"
    },
    "./nest": {
      "import": "./dist/nest/index.js",
      "require": "./dist/nest/index.js",
      "types": "./dist/nest/index.d.ts"
    },
    "./globals": {
      "import": "./dist/globals/index.js",
      "require": "./dist/globals/index.js",
      "types": "./dist/globals/index.d.ts"
    }
  },
  "devDependencies": {
    "@jest/globals": "^30.0.5",
    "@nestjs/testing": "^11.1.6",
    "@repo/typescript-config": "workspace:*",
    "@types/jest": "^30.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.1",
    "typescript": "^5.8.2"
  }
}
