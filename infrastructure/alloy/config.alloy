// Alloy: tails the app's JSON log files and ships them to Loki.
// One file for every environment. Per-env values come from the container's environment:
//   ALLOY_ENV  label stamped on every line (local | dev | prod), set in each compose file
//   LOKI_URL   Loki push endpoint, from .env on the server (defaults to the local observability stack)

// 1. Find the files: every service folder, every dated log.
local.file_match "app_logs" {
  path_targets = [{ "__path__" = "/var/log/a11studio/*/*.log" }]
  sync_period  = "10s"
}

// 2. Tail them and hand each line to the processor.
loki.source.file "app" {
  targets    = local.file_match.app_logs.targets
  forward_to = [loki.process.app.receiver]
}

// 3. Parse the JSON, use the line's own time, promote only low-cardinality labels.
//    id / operation / replica / extraInfo stay in the line: query them with `| json`.
loki.process "app" {
  stage.json {
    expressions = {
      service = "service",
      channel = "channel",
      level   = "level",
      method  = "method",
      ts      = "timestamp",
    }
  }

  stage.timestamp {
    source = "ts"
    format = "RFC3339Nano"
  }

  stage.labels {
    values = {
      service = "",
      channel = "",
      level   = "",
      method  = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}

// 4. Ship to Loki, stamping every line with the environment.
loki.write "default" {
  endpoint {
    url = coalesce(sys.env("LOKI_URL"), "http://loki:3100/loki/api/v1/push")
  }

  external_labels = {
    env = coalesce(sys.env("ALLOY_ENV"), "local"),
  }
}
