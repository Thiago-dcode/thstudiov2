# ===========================================================================
# HTTPS template (DigitalOcean droplet)
#
# This file is a TEMPLATE and is intentionally NOT loaded by nginx (only files
# matching /etc/nginx/conf.d/*.conf are loaded).
#
# How to enable TLS on the droplet:
#
# 1. Point your domain's A/AAAA records at the droplet's public IP.
#
# 2. Set DOMAIN and LETSENCRYPT_EMAIL in your `.env` file, e.g.
#        DOMAIN=studio.example.com
#        LETSENCRYPT_EMAIL=you@example.com
#
# 3. Bring the stack up (HTTP only) so the ACME challenge can be served:
#        docker compose -f compose.dev.yaml up -d nginx web api
#
# 4. Obtain the certificate (certbot runs under the `ssl` profile):
#        docker compose -f compose.dev.yaml --profile ssl run --rm certbot
#
# 5. Copy this file into conf.d, replacing the http-only server, and replace
#    every __DOMAIN__ with your real domain:
#        cp nginx/ssl.conf.template nginx/conf.d/default.conf
#    (keep the acme-challenge + redirect server below, drop the old plain
#     `location /` + `location /api/` 80 server, then reload)
#        docker compose -f compose.dev.yaml exec nginx nginx -s reload
#
# 6. Auto-renew (cron on the droplet, twice daily is recommended):
#        docker compose -f compose.dev.yaml --profile ssl run --rm certbot renew \
#          && docker compose -f compose.dev.yaml exec nginx nginx -s reload
# ===========================================================================

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Redirect all HTTP traffic to HTTPS (and keep serving ACME challenges).
server {
    listen      80;
    listen      [::]:80;
    server_name __DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name __DOMAIN__;

    resolver 127.0.0.11 valid=10s ipv6=off;
    # 320m, not 50m: media uploads accept video up to MAX_VIDEO_UPLOAD_MB (300MB), and the
    # multipart envelope needs headroom on top. Keep in sync with packages/common-lib
    # constants/limits.ts and apps/web/next.config.ts serverActions.bodySizeLimit.
    client_max_body_size 320m;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # HSTS (enable once you're confident TLS is stable).
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location /api/ {
        set $api_upstream api:8080;
        proxy_pass http://$api_upstream;
        include /etc/nginx/snippets/proxy.conf;
    }

    location / {
        set $web_upstream web:3000;
        proxy_pass http://$web_upstream;
        include /etc/nginx/snippets/proxy.conf;
    }
}
