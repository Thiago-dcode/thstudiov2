{
  "extends": "@repo/typescript-config/nestjs.json",
  "compilerOptions": {
    // This app stays on TypeScript 6 (see package.json): the Nest CLI needs the
    // programmatic compiler API, which TS 7.0 does not ship. `baseUrl` must stay
    // with it — the Nest SWC builder reads it straight from here and panics on an
    // empty value. Map only `src/*` so absolute `src/...` imports still rewrite
    // to relative requires. A catch-all `"*": ["./*"]` makes SWC rewrite package
    // imports like `@nestjs/common` to `node_modules/@nestjs/common`, which Node
    // cannot resolve from `dist/`.
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node","jest","multer"],
    "paths": {
      "src/*": ["./src/*"],
      "stripe-types/*": ["./node_modules/stripe/cjs/resources/*.d.ts"],
      "stripe-types/checkout": ["./node_modules/stripe/cjs/resources/Checkout/index.d.ts"]
    },
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"],
  "watchOptions": {
    "excludeDirectories": ["**/node_modules", "dist", ".turbo"]
  }
}
