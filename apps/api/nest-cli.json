{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": {
      "type": "swc",
      "options": {
        "stripLeadingPaths": true
      }
    },
    "typeCheck": true,
    "watchAssets": true,
    "assets": [
      {
        "include": "i18n/**/*",
        "outDir": "dist"
      }
    ]
  }
}
