<%- include(globals.emailsPath + '/shared/head') %>

<body style="width:100%; margin:0; padding:0; background-color:#1C1B19;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#1C1B19;">
        <tr>
            <td align="center">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"
                    style="width:100%; max-width:600px; background-color:#242220;">

                    <%- include(globals.emailsPath + '/shared/header') %>

                    <!-- Content -->
                    <tr>
                        <td style="padding:40px 40px 0 40px; text-align:center;">
                            <p style="font-family:Arial, Helvetica, sans-serif; font-size:13px; color:#A8A59B; letter-spacing:1px; text-transform:uppercase; margin:0 0 8px 0;">
                                <%= globals.t(translatePath + '.HI') %>
                            </p>
                            <p style="font-family:Georgia, 'Times New Roman', Times, serif; font-size:20px; color:#F0EEE9; margin:0 0 32px 0; font-weight:normal;">
                                <%= user.username %>
                            </p>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:0 40px; text-align:center;">
                            <h1 style="font-family:Georgia, 'Times New Roman', Times, serif; font-size:32px; font-weight:normal; color:#F0EEE9; margin:0 0 12px 0; letter-spacing:1px;">
                                <%= globals.t(translatePath + '.TITLE') %>
                            </h1>
                            <p style="font-family:Georgia, 'Times New Roman', Times, serif; font-size:15px; color:#A8A59B; margin:0 0 36px 0; line-height:1.6;">
                                <%= globals.t(translatePath + '.DESCRIPTION') %>
                            </p>
                        </td>
                    </tr>

                    <!-- CTA Button -->
                    <tr>
                        <td align="center" style="padding:0 40px 32px 40px;">
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center" style="background-color:#C41D00;">
                                        <a href="<%= passwordRecoveryAttempt.fallback_url %>?attempt=<%= passwordRecoveryAttempt.code %>"
                                            style="display:inline-block; padding:16px 48px; font-family:Arial, Helvetica, sans-serif; font-size:13px; font-weight:bold; text-decoration:none; color:#FFFFFF; letter-spacing:1.5px; text-transform:uppercase;">
                                            <%= globals.t(translatePath + '.BUTTON_TEXT') %>
                                        </a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Fallback Link -->
                    <tr>
                        <td align="center" style="padding:0 40px 36px 40px;">
                            <p style="font-family:Arial, Helvetica, sans-serif; font-size:11px; color:#A8A59B; margin:0 0 8px 0; letter-spacing:0.5px;">
                                <%= globals.t(translatePath + '.LINK_LABEL') %>
                            </p>
                            <p style="font-family:Arial, Helvetica, sans-serif; font-size:11px; margin:0; word-break:break-all;">
                                <a href="<%= passwordRecoveryAttempt.fallback_url %>?attempt=<%= passwordRecoveryAttempt.code %>"
                                    style="color:#FF4D3A; text-decoration:underline;">
                                    <%= passwordRecoveryAttempt.fallback_url %>?attempt=<%= passwordRecoveryAttempt.code %>
                                </a>
                            </p>
                        </td>
                    </tr>

                    <!-- Security Warning -->
                    <tr>
                        <td align="center" style="padding:0 40px 32px 40px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                                style="background-color:#2B0A0A; border:1px solid #991b1b;">
                                <tr>
                                    <td style="padding:16px 20px; text-align:center;">
                                        <p style="font-family:Georgia, 'Times New Roman', Times, serif; font-size:13px; margin:0; color:#ef4444; line-height:1.5;">
                                            <%= globals.t(translatePath + '.SECURITY_WARNING') %>
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Expiration -->
                    <tr>
                        <td align="center" style="padding:0 40px 8px 40px;">
                            <p style="font-family:Arial, Helvetica, sans-serif; font-size:12px; margin:0; color:#A8A59B; line-height:1.5;">
                                <%= globals.t(translatePath + '.EXPIRATION_INFO') %>
                            </p>
                        </td>
                    </tr>

                    <%- include(globals.emailsPath + '/shared/footer') %>

                </table>
            </td>
        </tr>
    </table>
</body>

</html>
