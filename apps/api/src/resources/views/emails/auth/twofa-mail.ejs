<%- include(globals.emailsPath + '/shared/head') %>


<body style=" width:600px; margin:0 auto;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; ">
    <%- include(globals.emailsPath + '/shared/header') %>
    <tr>
      <td align="center" style="padding:20px 0;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"
          style="width:100%; max-width:600px; border-radius:8px; overflow:hidden;">

          <!-- Introduction -->
          <tr>
            <td align="center">
              <p style="font-size:18px; margin-bottom:5px;"><%= globals.t(translatePath + '.HI') %> <span
                  style="font-weight:bold;"><%= user.username %></span>
              </p>
              <h1 style="font-size:42px; margin-bottom:5px;"><%= globals.t(translatePath + '.TITLE') %></h1>
              <p style="font-size:16px; margin-bottom:32px; color:#555555;">
                <%= globals.t(translatePath + '.DESCRIPTION') %>
              </p>
            </td>
          </tr>

          <!-- Verification Code Box -->
          <tr>
            <td align="center" style="padding:0px 0px 32px 0px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                style="width:100%; overflow:hidden; border-spacing:0; border:1px solid #e5e5e5; border-radius:8px; background-color:white; box-shadow:0 0 10px 0 rgba(0, 0, 0, 0.1);">
                <tr>
                  <td style="padding:24px; text-align:center;">
                    <p style="font-size:14px; margin-bottom:12px; color:#555555;">
                      <%= globals.t(translatePath + '.CODE_LABEL') %>
                    </p>
                    <p style="font-size:36px; font-weight:bold; letter-spacing:8px; margin:0; color:#343231; font-family: 'Courier New', monospace;">
                      <%= user.twofa_code %>
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Security Notice -->
          <tr>
            <td align="center" style="padding:0px 20px 32px 20px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                style="background-color:#FFF9E6; border-radius:8px; border:1px solid #FFE5A3;">
                <tr>
                  <td style="padding:16px; text-align:center;">
                    <p style="font-size:14px; margin:0; color:#666666;">
                      <%= globals.t(translatePath + '.SECURITY_WARNING') %>
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Expiration Info -->
          <tr>
            <td align="center" style="padding:0px 20px 32px 20px;">
              <p style="font-size:14px; margin:0; color:#888888;">
                <%= globals.t(translatePath + '.EXPIRATION_INFO') %>
              </p>
            </td>
          </tr>

          <tr>
            <td>
              <%- include(globals.emailsPath + '/shared/footer') %>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>

</html>

