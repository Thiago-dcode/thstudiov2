<%- include(globals.emailsPath + '/shared/head') %>

<body style="width:100%; margin:0; padding:0; background-color:#1C1B19;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#1C1B19;">
        <tr>
            <td align="center">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"
                    style="width:100%; max-width:600px; background-color:#242220;">

                    <%- include(globals.emailsPath + '/shared/header') %>

                    <tr>
                        <td style="padding:40px 40px 0 40px; text-align:center;">
                            <h1 style="font-family:Georgia, 'Times New Roman', Times, serif; font-size:32px; font-weight:normal; color:#F0EEE9; margin:0 0 12px 0; letter-spacing:1px;">
                                <%= globals.t(translatePath + '.VALIDATE_TITLE') %>
                            </h1>
                            <p style="font-family:Georgia, 'Times New Roman', Times, serif; font-size:15px; color:#A8A59B; margin:0 0 30px 0; line-height:1.6;">
                                <%= globals.t(translatePath + '.VALIDATE_DESCRIPTION') %>
                            </p>
                        </td>
                    </tr>

                    <tr>
                        <td align="center" style="padding:0 40px 32px 40px;">
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center" style="background-color:#C41D00;">
                                        <a href="<%= invite.validationUrl %>"
                                            style="display:inline-block; padding:16px 48px; font-family:Arial, Helvetica, sans-serif; font-size:13px; font-weight:bold; text-decoration:none; color:#FFFFFF; letter-spacing:1.5px; text-transform:uppercase;">
                                            <%= globals.t(translatePath + '.VALIDATE_CTA_TEXT') %>
                                        </a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <%- include(globals.emailsPath + '/shared/footer') %>

                </table>
            </td>
        </tr>
    </table>
</body>

</html>
