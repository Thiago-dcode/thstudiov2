<%- include(globals.emailsPath + '/shared/head') %>

<body style="width:100%; margin:0; padding:0; background-color:#141312;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#141312;">
        <tr>
            <td align="center">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"
                    style="width:100%; max-width:600px; background-color:#1c1b19;">

                    <%- include(globals.emailsPath + '/shared/header') %>

                    <tr>
                        <td style="padding:40px 40px 0 40px; text-align:center;">
                            <% if (invite.validationUrl) { %>
                                <p style="font-family:Arial, Helvetica, sans-serif; font-size:13px; color:#807a73; letter-spacing:1px; text-transform:uppercase; margin:0 0 8px 0;">
                                    <%= globals.t(translatePath + '.VALIDATE_TIER_LABEL') %>
                                </p>
                                <h1 style="font-family:Georgia, 'Times New Roman', Times, serif; font-size:32px; font-weight:normal; color:#e8e4df; margin:0 0 12px 0; letter-spacing:1px;">
                                    <%= globals.t(translatePath + '.VALIDATE_TITLE') %>
                                </h1>
                                <p style="font-family:Georgia, 'Times New Roman', Times, serif; font-size:15px; color:#b5afa8; margin:0 0 30px 0; line-height:1.6;">
                                    <%= globals.t(translatePath + '.VALIDATE_DESCRIPTION') %>
                                </p>
                            <% } else { %>
                                <p style="font-family:Arial, Helvetica, sans-serif; font-size:13px; color:#807a73; letter-spacing:1px; text-transform:uppercase; margin:0 0 8px 0;">
                                    <%= globals.t(translatePath + '.TIER_LABEL') %>: <%= invite.benefitType %>
                                </p>
                                <h1 style="font-family:Georgia, 'Times New Roman', Times, serif; font-size:32px; font-weight:normal; color:#e8e4df; margin:0 0 12px 0; letter-spacing:1px;">
                                    <%= globals.t(translatePath + '.TITLE') %>
                                </h1>
                                <p style="font-family:Georgia, 'Times New Roman', Times, serif; font-size:15px; color:#b5afa8; margin:0 0 30px 0; line-height:1.6;">
                                    <%= globals.t(translatePath + '.DESCRIPTION') %>
                                </p>
                            <% } %>
                        </td>
                    </tr>

                    <% if (!invite.validationUrl) { %>
                        <tr>
                            <td align="center" style="padding:0 40px 32px 40px;">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                                    style="background-color:#0f0e0d; border:1px solid #2a2826;">
                                    <tr>
                                        <td style="padding:22px 24px; text-align:center;">
                                            <p style="font-family:Georgia, 'Times New Roman', Times, serif; font-size:18px; color:#c9b99a; margin:0 0 10px 0;">
                                                #<%= invite.position %> / <%= invite.benefitType %>
                                            </p>
                                            <p style="font-family:Georgia, 'Times New Roman', Times, serif; font-size:14px; color:#b5afa8; margin:0; line-height:1.6;">
                                                <%= globals.t(translatePath + '.BENEFIT_DESCRIPTION').replace('{months}', invite.benefitMonths).replace('{benefitType}', invite.benefitType) %>
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    <% } %>

                    <tr>
                        <td align="center" style="padding:0 40px 32px 40px;">
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center" style="background-color:#e8e4df;">
                                        <a href="<%= invite.validationUrl ?? invite.registrationUrl %>"
                                            style="display:inline-block; padding:16px 48px; font-family:Arial, Helvetica, sans-serif; font-size:13px; font-weight:bold; text-decoration:none; color:#0f0e0d; letter-spacing:1.5px; text-transform:uppercase;">
                                            <%= invite.validationUrl ? globals.t(translatePath + '.VALIDATE_CTA_TEXT') : globals.t(translatePath + '.CTA_TEXT') %>
                                        </a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <% if (invite.expiresInDays) { %>
                        <tr>
                            <td align="center" style="padding:0 40px 24px 40px;">
                                <p style="font-family:Arial, Helvetica, sans-serif; font-size:12px; color:#807a73; margin:0; line-height:1.5;">
                                    <%= globals.t(translatePath + '.EXPIRATION_NOTE').replace('{days}', invite.expiresInDays) %>
                                </p>
                            </td>
                        </tr>
                    <% } %>

                    <tr>
                        <td align="center" style="padding:0 40px 8px 40px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                                style="background-color:#2a2317; border:1px solid #4a3d2a;">
                                <tr>
                                    <td style="padding:16px 20px; text-align:center;">
                                        <p style="font-family:Georgia, 'Times New Roman', Times, serif; font-size:13px; margin:0; color:#c9a87c; line-height:1.5;">
                                            <%= globals.t(translatePath + '.URGENCY_NOTE') %>
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <%- include(globals.emailsPath + '/shared/footer') %>

                </table>
            </td>
        </tr>
    </table>
</body>

</html>
