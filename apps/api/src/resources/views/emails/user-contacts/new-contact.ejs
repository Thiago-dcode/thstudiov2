<%- include(globals.emailsPath + '/shared/head') %>

<body class="e-bg" style="width:100%; margin:0; padding:0 4px; background-color:#FAFAF9;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="e-bg" style="background-color:#FAFAF9;">
        <tr>
            <td align="center">
                <table role="presentation" width="800" cellpadding="0" cellspacing="0" border="0"
                    class="e-bg" style="width:100%; max-width:800px; background-color:#FAFAF9;">

                    <%- include(globals.emailsPath + '/shared/header') %>

                    <!-- Greeting -->
                    <tr>
                        <td style="padding:0 0 24px; text-align:center;">
                            <p class="e-text-muted" style="font-size:13px; color:#46443F; letter-spacing:1px; text-transform:uppercase;">
                                <%= globals.t(translatePath + '.HI') %>
                            </p>
                            <h2 class="e-text" style="font-size:20px; padding-top:8px; font-weight:600; color:#000000;">
                                <%= artist.username %>
                            </h2>
                            <p class="e-text" style="font-size:14px; padding-top:15px; letter-spacing:1px; color:#000000;">
                                <%= globals.t(translatePath + '.TITLE') %>
                            </p>
                        </td>
                    </tr>

                    <!-- Contact Details -->
                    <tr>
                        <td>
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                                class="e-card e-border-em" style="border:1.5px solid #C9C6BB; background-color:#FFFFFF;">

                                <tr>
                                    <td style="padding:24px 12px;">
                                        <p class="e-text-muted" style="font-size:11px; color:#46443F; letter-spacing:1px; text-transform:uppercase; margin:0 0 8px 0;">
                                            <%= globals.t(translatePath + '.CONTACT_NAME') %>
                                        </p>
                                        <p class="e-text" style="margin:0; color:#000000;">
                                            <%= contact.contact_name %>
                                        </p>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding:0;">
                                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                            <tr><td class="e-border" style="height:1px; background-color:#E4E1D9; font-size:1px; line-height:1px;">&nbsp;</td></tr>
                                        </table>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding:24px 12px;">
                                        <p class="e-text-muted" style="font-size:11px; color:#46443F; letter-spacing:1px; text-transform:uppercase; margin:0 0 8px 0;">
                                            <%= globals.t(translatePath + '.CONTACT_EMAIL') %>
                                        </p>
                                        <p style="margin:0;">
                                            <a href="mailto:<%= contact.contact_email %>" class="e-accent" style="color:#ED2100; text-decoration:underline;">
                                                <%= contact.contact_email %>
                                            </a>
                                        </p>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding:0;">
                                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                            <tr><td class="e-border" style="height:1px; background-color:#E4E1D9; font-size:1px; line-height:1px;">&nbsp;</td></tr>
                                        </table>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding:24px 12px;">
                                        <p class="e-text-muted" style="font-size:11px; color:#46443F; letter-spacing:1px; text-transform:uppercase; margin:0 0 8px 0;">
                                            <%= globals.t(translatePath + '.SUBJECT_LABEL') %>
                                        </p>
                                        <p class="e-text" style="margin:0; color:#000000;">
                                            <%= contact.subject %>
                                        </p>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding:0;">
                                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                            <tr><td class="e-border" style="height:1px; background-color:#E4E1D9; font-size:1px; line-height:1px;">&nbsp;</td></tr>
                                        </table>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding:24px 12px;">
                                        <p class="e-text-muted" style="font-size:11px; color:#46443F; letter-spacing:1px; text-transform:uppercase; margin:0 0 8px 0;">
                                            <%= globals.t(translatePath + '.MESSAGE_LABEL') %>
                                        </p>
                                        <p class="e-text" style="margin:0; color:#000000; line-height:1.7; white-space:pre-wrap;"><%= (contact.message || '').trim() %></p>
                                    </td>
                                </tr>

                            </table>
                        </td>
                    </tr>

                    <!-- Footer Note -->
                    <tr>
                        <td align="center" style="padding:20px 0;">
                            <p class="e-text-muted" style="font-size:12px; color:#46443F; margin:0;">
                                <%= globals.t(translatePath + '.FOOTER_NOTE') %>
                            </p>
                        </td>
                    </tr>

                    <%- include(globals.emailsPath + '/shared/footer') %>

                </table>
            </td>
        </tr>
    </table>
</body>

</html>
