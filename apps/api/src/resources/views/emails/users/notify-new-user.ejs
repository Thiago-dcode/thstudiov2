<%- include(globals.emailsPath + '/shared/head') %>

<body style="width:100%; margin:0; padding:0; background-color:#141312;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#141312;">
        <tr>
            <td align="center">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"
                    style="width:100%; max-width:600px; background-color:#1c1b19;">

                    <%- include(globals.emailsPath + '/shared/header') %>

                    <!-- Greeting -->
                    <tr>
                        <td style="padding:40px 40px 0 40px; text-align:center;">
                            <p style="font-family:Arial, Helvetica, sans-serif; font-size:13px; color:#807a73; letter-spacing:1px; text-transform:uppercase; margin:0 0 8px 0;">
                                <%= globals.t(translatePath + '.HI') %>
                            </p>
                            <p style="font-family:Georgia, 'Times New Roman', Times, serif; font-size:20px; color:#e8e4df; margin:0 0 32px 0; font-weight:normal;">
                                <%= user.username %>
                            </p>
                        </td>
                    </tr>

                    <!-- Welcome Title -->
                    <tr>
                        <td style="padding:0 40px; text-align:center;">
                            <h1 style="font-family:Georgia, 'Times New Roman', Times, serif; font-size:32px; font-weight:normal; color:#e8e4df; margin:0 0 12px 0; letter-spacing:1px;">
                                <%= globals.t(translatePath + '.WELCOME') %>
                            </h1>
                            <p style="font-family:Georgia, 'Times New Roman', Times, serif; font-size:15px; color:#b5afa8; margin:0 0 36px 0; line-height:1.6;">
                                <%= globals.t(translatePath + '.WELCOME_MESSAGE') %>
                            </p>
                        </td>
                    </tr>

                    <% if (typeof features !== 'undefined' && Array.isArray(features) && features.length > 0) { %>
                    <!-- Features Intro -->
                    <tr>
                        <td style="padding:0 40px 16px 40px; text-align:center;">
                            <p style="font-family:Georgia, 'Times New Roman', Times, serif; font-size:16px; color:#b5afa8; margin:0; line-height:1.6;">
                                <%= globals.t(translatePath + '.FEATURES_INTRO_PREFIX') %>
                                <span style="color:#e8e4df; font-weight:bold;"><%= globals.appName %></span>
                                <%= globals.t(translatePath + '.FEATURES_INTRO_SUFFIX') %>
                            </p>
                        </td>
                    </tr>

                    <!-- Features List -->
                    <tr>
                        <td style="padding:0 40px 36px 40px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                                style="background-color:#0f0e0d; border:1px solid #2a2826;">
                                <% features.forEach(function(feature, index) { %>
                                <tr>
                                    <td style="padding:14px 20px; text-align:center; font-family:Georgia, 'Times New Roman', Times, serif; font-size:14px; color:#e8e4df;<%= index > 0 ? ' border-top:1px solid #2a2826;' : '' %>">
                                        <%= feature %>
                                    </td>
                                </tr>
                                <% }) %>
                            </table>
                        </td>
                    </tr>
                    <% } %>

                    <!-- CTA -->
                    <tr>
                        <td align="center" style="padding:0 40px 8px 40px;">
                            <p style="font-family:Georgia, 'Times New Roman', Times, serif; font-size:15px; color:#b5afa8; margin:0 0 16px 0;">
                                <%= globals.t(translatePath + '.CTA_START_TEXT') %>
                            </p>
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center" style="background-color:#e8e4df;">
                                        <a href="<%= globals.appUrl %>"
                                            style="display:inline-block; padding:16px 48px; font-family:Arial, Helvetica, sans-serif; font-size:13px; font-weight:bold; text-decoration:none; color:#0f0e0d; letter-spacing:1.5px; text-transform:uppercase;">
                                            <%= globals.t(translatePath + '.CTA_START_BUTTON') %>
                                        </a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <%- include(globals.emailsPath + '/shared/footer') %>

                </table>
            </td>
        </tr>
    </table>
</body>

</html>
