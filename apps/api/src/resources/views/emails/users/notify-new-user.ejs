<%- include(globals.emailsPath + '/shared/head') %>

  main {
    width: 100%;
  }

  .container-welcome {
    width: 100%;
    padding: 0 30px;
  }

  #welcome {
    text-align: center;
    margin-bottom: 10px;
  }

  #welcome h1 {
    font-size: 42px;
    font-weight: bold;
  }

  .main-content {
    width: 100%;
    padding: 20px;
    text-align: center;
    margin-bottom: 10px;
  }



  .main-content .features {
    list-style: disc;
    list-style-position: inside;
    padding: 12px 16px;
    margin: 0 auto;
    background-color: #fff;
    width: 100%;
    list-style-type: none;

  }

  .main-content .features-title {
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 10px;
  }

  .main-content .features li {
    text-align: center;
    padding: 8px 0;
    border-bottom: 1px solid #333;
    font-size: 15px;
    line-height: 1.5;
  }

  .main-content .features li:first-child {
    border-top: none;
  }

  .description {
    text-align: center;
    max-width: 500px;
  }

  .highlight {
    font-weight: bold;
  }

  .link-container {
    text-align: center;
  }

  .link-container .verify-account-title {
    font-size: 18px;
    font-weight: 500;
  }

  .link-container a {
    font-size: 16px;
    font-weight: bold;
    color: #fff;
    background-color: #333;
    padding: 10px 20px;
    border-radius: 5px;
    text-decoration: none;
    display: inline-block;
    margin-top: 6px;
  }

  @media (max-width: 600px) {
    .main-content {
      width: 100%;
      max-width: 100vw;
    }

    .main-content .features {
      width: 100%;
      max-width: 100vw;
    }
  }
</style>
</head>
<%- include(globals.emailsPath + '/shared/body-header') %>
<section class="container-welcome container-flex-col-center">
  <div id="welcome">
    <p>Hi <span class="highlight"><%= user.username %></span></p>
    <h1>WELCOME</h1>
    <p>We are excited to have you on board.</p>

  </div>
  <div class="main-content ">
    <p class="features-title">With <span class="highlight"><%= globals.appName %></span> you will be able to:</p>
    <ul class="features">
      <% if (typeof features !== 'undefined' && Array.isArray(features) && features.length > 0) { %>
      <% features.forEach(function(feature) { %>
      <li><%= feature %></li>
      <% }) %>
      <% } %>
    </ul>
  </div>
  <div class="link-container">
    <%if(user.email_validated){%>
    <h4 class="verify-account-title">Start creating your
      portfolio</h4>
    <a href="<%= globals.appUrl %>">Start
      now</a>
    <% } else{ %>
    <h4 class="verify-account-title">Verify your account to
      start creating your portfolio</h4>
    <a href="<%= globals.appUrl %>">Verify
      your account</a>
    <% } %>
  </div>

</section>
<%- include(globals.emailsPath + '/shared/footer') %>