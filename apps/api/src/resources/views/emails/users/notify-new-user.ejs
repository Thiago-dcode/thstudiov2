<%- include('../shared/layout-top') %>
<style>
  main {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: start;
  }

  .container-welcome {
    width: 100%;
    gap: 20px;
    padding: 0 30px;
  }

  #welcome {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: start;
    gap: 10px;
  }

  #welcome h1 {
    font-size: 42px;
    font-weight: bold;
    color: #333;
  }

  .main-content {
    width: 100%;
    gap: 20px;
    padding: 20px;
    border-radius: 10px;
    background-color: #f0f0f0;
    gap: 20px;
    align-items: center;
  }
  .main-content .container-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: start;
    gap: 20px;
  }

  .main-content .container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: start;
    gap: 5px;
    text-align: justify;
  }
  .main-content .features {
    align-items: start;
    display: flex;
    flex-direction: column;
    align-items: start;
    justify-content: start;
    gap: 5px;
  }
  .main-content .container.features ul {
    width: 100%;
    margin-left: 20px;
    display: flex;
    flex-direction: column;
    align-items: start;
    justify-content: start;
    gap: 5px;
  }

  .description {
    text-align: center;
    max-width: 500px;
  }

  .highlight {
    font-weight: bold;
  }
  .link-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
 
  .link-container a {
    font-size: 16px;
    font-weight: bold;
    color: #fff;
    background-color: #333;
    padding: 10px 20px;
    border-radius: 5px;
    text-decoration: none;
  }
  @media (max-width: 600px) {
    .main-content  {
      max-width: 100vw;
    }
  }
</style>

<section class="container-welcome container-flex-col-center">
  <div id="welcome">
    <h1>WELCOME👋</h1>
    <p>Hi <span class="highlight"><%= user.username %></span>, we are excited to have you on board.</p>
  </div>
  <div class="main-content container-flex-col-center">
  <div class="container-content">
    <div class="container">
      <h3>What is <span class="highlight"><%= globals.appName %></span>?</h3>
      <p class="description">Is like your favourite social media, but mainly focused on create a portfolio to attract
        potential clients</p>
    </div>
    <div class="container">
      <div class=" features">
        <h3>What you will be able to do with?</h3>
        <ul>
          <li>Create oustanding portfolio(s)</li>
          <li>Manage and add projects, media, collections ...</li>
          <li>Show your available services</li>
          <li>Organize all your artworks</li>
          <li>Add info about your clients</li>
          <h5>And much more!</h5>
        </ul>
       
      </div>
    </div>
  </div>

  </div>
  <div class="link-container">
    <%if(true){%>
    <h4>Start creating your portfolio</h4>
    <a href="<%= globals.appUrl %>">Start now</a>
    <% } else{ %>
    <h4>Verify your account to start creating your portfolio</h4>
    <p class="description">You need to verify your account to start using <span
        class="highlight"><%= globals.appName %></span>.</p>
    <a href="<%= globals.appUrl %>">Verify your account</a>
    <% } %>
  </div>

</section>

<%- include('../shared/layout-bottom') %>