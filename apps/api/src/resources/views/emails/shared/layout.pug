//- layout.pug
html
  head
    title  #{globals.appName}
    style
      | body {
      |   font-family: Arial, sans-serif;
      |   margin: 0;
      |   padding: 0;
      |   background-color: #f0f0f0;
      | }
      | header {
      |   background-color: #333;
      |   color: #fff;
      |   padding: 20px;
      | }
      | #footer {
      |   background-color: #333;
      |   color: #fff;
      |   padding: 20px;
      | }
  body
    header
      h1 #{globals.appName}
    block content
    block footer
      #footer
        p #{globals.appName}
