<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <title><%= globals.appName %></title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    .container-flex-col-center {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: start;
    }

    body {
      font-family: Verdana, Geneva, Tahoma, sans-serif;
      gap: 30px;
      margin: 0 auto;
    }

    header {
      background-color: #333;
      color: #fff;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    @media (max-width: 600px) {
      body {
        width: 100%;
        max-width: 100%;
      }
    }
  </style>
</head>

<body class="container-flex-col-center">
  <header>
    <h1><%= globals.appName.toUpperCase() %></h1>
  </header>
