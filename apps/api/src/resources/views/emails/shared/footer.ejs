<tr>
    <td style="padding:32px 0 0 0;">
        <% const footerUnsubscribeUrl = (typeof unsubscribeUrl !== 'undefined' && unsubscribeUrl) || (typeof ususcribeUrl !== 'undefined' && ususcribeUrl) || (typeof unsuscribeUrl !== 'undefined' && unsuscribeUrl) || ''; %>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
                <td style="padding:0 40px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                        <tr>
                            <td class="e-border" style="height:1px; background-color:#E4E1D9; font-size:1px; line-height:1px;">&nbsp;</td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr>
                <td style="padding:20px 0 12px 0; text-align:center;">
                    <p class="brand e-text" style="margin:0; font-family:Archivo, Arial, Helvetica, sans-serif; font-size:14px; font-weight:600; letter-spacing:1.5px; color:#000000;">
                        A<span class="e-accent" style="font-family:Archivo, Arial, Helvetica, sans-serif; color:#ED2100;">11</span>STUDIO
                    </p>
                </td>
            </tr>
            <tr>
                <td style="padding:0 0 24px 0; text-align:center;">
                    <p class="e-text-muted" style="margin:0 0 6px 0;  color:#46443F; letter-spacing:0.5px;">
                        &copy; <%= new Date().getFullYear() %> <%= globals.appName %> &middot;
                        <%= t('email.FOOTER.ALL_RIGHTS_RESERVED') %>
                    </p>
                    <a href="<%= globals.appUrl %>" class="e-text-muted" style=" color:#46443F; text-decoration:none; letter-spacing:0.5px;">
                        <%= globals.beautyUrl %>
                    </a>
                    <% const footerContact = (typeof companyInfo !== 'undefined' && companyInfo) || {}; %>
                    <% if (footerContact.address) { %>
                        <p class="e-text-muted" style="margin:10px 0 0 0; color:#8F8C84; font-size:11px; line-height:1.5; letter-spacing:0.3px;">
                            <%= footerContact.address %>
                        </p>
                    <% } %>
                    <% if (footerContact.social && footerContact.social.instagram) { %>
                        <p style="margin:8px 0 0 0;">
                            <a href="<%= footerContact.social.instagram %>" class="e-text-muted" style="color:#46443F; text-decoration:none; font-size:11px; letter-spacing:0.3px;">
                                Instagram
                            </a>
                        </p>
                    <% } %>
                    <% if (footerUnsubscribeUrl) { %>
                        <p style="margin:10px 0 0 0; font-size:10px; color:#8F8C84; line-height:1.5;">
                            <a href="<%= footerUnsubscribeUrl %>" class="e-text-muted" style="color:#8F8C84; text-decoration:underline; text-decoration-color:#C9C6BB;">
                                Unsubscribe
                            </a>
                        </p>
                    <% } %>
                </td>
            </tr>
        </table>
    </td>
</tr>
