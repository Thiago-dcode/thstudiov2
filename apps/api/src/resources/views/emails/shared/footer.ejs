<tr>
    <td style="padding:32px 0 0 0;">
        <% const footerUnsubscribeUrl = (typeof unsubscribeUrl !== 'undefined' && unsubscribeUrl) || (typeof ususcribeUrl !== 'undefined' && ususcribeUrl) || (typeof unsuscribeUrl !== 'undefined' && unsuscribeUrl) || ''; %>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
                <td style="padding:0 40px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                        <tr>
                            <td style="height:1px; background-color:#2a2826; font-size:1px; line-height:1px;">&nbsp;</td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr>
                <td style="padding:20px 0 24px 0; text-align:center;">
                    <p style="margin:0 0 6px 0; font-family:Arial, Helvetica, sans-serif; font-size:11px; color:#807a73; letter-spacing:0.5px;">
                        &copy; <%= new Date().getFullYear() %> <%= globals.appName %> &middot;
                        <%= globals.t('email.FOOTER.ALL_RIGHTS_RESERVED') %>
                    </p>
                    <a href="<%= globals.appUrl %>" style="font-family:Arial, Helvetica, sans-serif; font-size:11px; color:#807a73; text-decoration:none; letter-spacing:0.5px;">
                        <%= globals.beautyUrl %>
                    </a>
                    <% if (footerUnsubscribeUrl) { %>
                        <p style="margin:10px 0 0 0; font-family:Arial, Helvetica, sans-serif; font-size:10px; color:#5f5a55; line-height:1.5;">
                            <a href="<%= footerUnsubscribeUrl %>" style="color:#5f5a55; text-decoration:underline; text-decoration-color:#3a3632;">
                                Unsubscribe
                            </a>
                        </p>
                    <% } %>
                </td>
            </tr>
        </table>
    </td>
</tr>
