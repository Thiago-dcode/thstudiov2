<%# Plain copy-paste fallback under a CTA button. Expects `url`. %>
<tr>
    <td align="center" style="padding:16px 24px 0;">
        <p class="e-text-muted" style="font-size:12px; color:#46443F; margin:0 0 4px 0; line-height:1.5;">
            <%= t('email.LINK_FALLBACK') %>
        </p>
        <p style="font-size:12px; margin:0; line-height:1.5; word-break:break-all;">
            <a href="<%= url %>" style="color:#46443F;"><%= url %></a>
        </p>
    </td>
</tr>
