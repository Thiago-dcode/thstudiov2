{
  "extends": "@repo/typescript-config/nestjs.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*spec.ts", "**/*.test.ts", "**/__tests__/**"],
  "watchOptions": {
    "excludeDirectories": ["**/node_modules", "dist", ".turbo"]
  }
}
