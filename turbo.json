{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["**/.env.*local", "**/.env", ".env", "tsconfig.json"],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "APP_URL",
        "APP_API_KEY",
        "APP_TOKEN",
        "API_V1_URL",
        "GEOAPIFY_URL",
        "GEOAPIFY_KEY",
        "ENCRYPTION_SECRET",
        "SUPPORT_EMAIL",
        "SUPPORT_USERNAME",
        "REGISTRATION_IS_CLOSED",
        "CDN_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": ["NODE_ENV=test"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["NODE_ENV=test"]
    },
    "test:e2e": {
      "dependsOn": ["^build"]
    },
    "dbcli": {}
  }
}
