# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*
!.env.example

# Testing
.nyc_output
blob-report/
coverage
test-results/
playwright/.cache/
playwright-report/

# TLS material — never commit (origin cert + private key live only on the host)
certs

# Runtime copies generated on the droplet from the canonical sources below.
# Canonical, version-controlled sources (tracked):
#   - dev.nginx/ & pro.nginx/                     (nginx config)
#   - scripts/deploy-dev.sh & scripts/deploy-prod.sh
#   - scripts/a11studio-dev.service & scripts/a11studio-prod.service
# On the droplet these are copied to the runtime names below, which stay ignored
# so they never collide with `git pull` during deploys.
/nginx/
scripts/deploy.sh
scripts/a11studio.service

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Cursor
.cursor/

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Debug
logs
storage/logs/*
!storage/logs/.gitkeep
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Misc
.DS_Store
*.pem
# Private keys must never be committable from anywhere, not just certs/.
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Local Claude Code tool-permission config — machine-specific, not for the repo.
.claude/settings.local.json
*.bak

# Database seed assets (large binaries; not committed — keep locally for `db:seed -n media` / `db:seed -n assets`)
packages/database/src/seeds/media-images/
packages/database/src/seeds/assets/

# API assets (large media files — keep locally, not in git)
apps/api/assets/

# Typescript
*.tsbuildinfo

sync-seed-assets.sh
SEO-AUDIT.md