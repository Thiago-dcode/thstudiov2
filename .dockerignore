# TLS material. The build context is the repo root, and on the droplet
# certs/cloudflare-origin.key is a wildcard private key covering *.a11studio.com —
# without this it is uploaded to the Docker daemon on every build.
certs
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

