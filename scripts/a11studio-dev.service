[Unit]
Description=TH Studio dev stack
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/root/apps/a11studio
ExecStart=/usr/bin/docker compose -f compose.dev.yaml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f compose.dev.yaml down

[Install]
WantedBy=multi-user.target
